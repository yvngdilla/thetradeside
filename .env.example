# Site
APP_URL=https://thetradeside.com
NEXT_PUBLIC_APP_NAME=Trade Side
# "open" (default): any firm can sign up and create a workspace.
# "invite": only invited emails and BOOTSTRAP_OWNER_EMAILS can sign in.
SIGNUP_MODE=open
BOOTSTRAP_OWNER_EMAILS=

# Sign-in form bot check (Cloudflare Turnstile, free). Create a widget for this
# domain at dash.cloudflare.com > Turnstile and set both keys. Leave both empty
# to turn the check off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email: sign-in links, team invites and certificates are sent through Resend
# from this domain (verify the domain in Resend first).
RESEND_API_KEY=
EMAIL_DOMAIN=thetradeside.com
# Optional: where feature suggestions from the app are emailed (they're saved in the database either way).
FEEDBACK_EMAIL=
# Any long random string. Encrypts Outlook tokens at rest. Never change it after launch.
TOKEN_ENCRYPTION_KEY=
# Any long random string. Vercel sends it to the hourly cron job.
CRON_SECRET=

# Supabase (Project Settings > API Keys). If you add Supabase from Vercel's Storage tab,
# it sets NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY instead; both work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Vendor research
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
FIRECRAWL_API_KEY=

# Optional: Outlook drafts instead of sending from Trade Side (Microsoft Entra app registration)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Online application filling (optional; the option is hidden until set)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
STAGEHAND_MODEL=anthropic/claude-sonnet-5-5
