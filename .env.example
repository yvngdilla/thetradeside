# Site
APP_URL=https://thetradeside.com
NEXT_PUBLIC_APP_NAME=Trade Side
# "invite" (default): only invited emails and BOOTSTRAP_OWNER_EMAILS can sign in.
# "open": anyone can sign up and create a workspace.
SIGNUP_MODE=invite
BOOTSTRAP_OWNER_EMAILS=
# Any long random string. Encrypts Outlook tokens at rest. Never change it after launch.
TOKEN_ENCRYPTION_KEY=
# Any long random string. Vercel sends it to the hourly cron job.
CRON_SECRET=

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Vendor research
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
FIRECRAWL_API_KEY=

# Outlook drafts (Microsoft Entra app registration)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Online application filling (optional; the option is hidden until set)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
STAGEHAND_MODEL=anthropic/claude-sonnet-5-5
