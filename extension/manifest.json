{
  "manifest_version": 3,
  "name": "Trade Side clipper",
  "short_name": "Trade Side",
  "version": "0.1.0",
  "description": "Add the product page or pin you have open to a project in Trade Side, with the price you see when signed in.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Add to Trade Side",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.thetradeside.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"]
}
